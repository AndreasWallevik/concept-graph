{
  "schema_version": 1,
  "id": "agentic-development",
  "title": "AI, MCP, and Agentic Development",
  "description": "From LLMs and built-in tools to MCP, live systems, Jev, and secure agentic development. Select a domain to explore relationships between concepts, risks, and controls. Jev means the TypeSafe AI model here.",
  "color_by": "layer",
  "nodes": [
    {
      "id": "domain-models",
      "label": "AI and Models",
      "type": "domain",
      "layer": "AI and Models",
      "description": "How models use context, generate outputs, and retrieve knowledge.",
      "url": "https://developers.openai.com/api/docs/guides/agents"
    },
    {
      "id": "domain-agents",
      "label": "Agents and Tools",
      "type": "domain",
      "layer": "Agents and Tools",
      "description": "How an agent receives goals, chooses tools, and acts through an execution loop.",
      "url": "https://developers.openai.com/api/docs/guides/agents"
    },
    {
      "id": "domain-mcp",
      "label": "MCP and Integration",
      "type": "domain",
      "layer": "MCP and Integration",
      "description": "A shared protocol and other ways to connect agents to data and live systems.",
      "url": "https://modelcontextprotocol.io/docs/2026-07-28/learn/architecture"
    },
    {
      "id": "domain-development",
      "label": "Agentic Development",
      "type": "domain",
      "layer": "Agentic Development",
      "description": "The path from task and plan to code, tests, review, and delivery."
    },
    {
      "id": "domain-security",
      "label": "Security and Trust",
      "type": "domain",
      "layer": "Security and Trust",
      "description": "Threats, trust boundaries, and technical controls around agent actions.",
      "url": "https://genai.owasp.org/2025/12/09/owasp-top-10-for-agentic-applications-the-benchmark-for-agentic-security-in-the-age-of-autonomous-ai/"
    },
    {
      "id": "domain-jev",
      "label": "Jev and Decisions",
      "type": "domain",
      "layer": "Jev and Decisions",
      "description": "Jev as a product-specific model for typed judgments and controlled routing.",
      "url": "https://docs.typesafe.ai/introduction"
    },
    {
      "id": "domain-quality",
      "label": "Quality and Operations",
      "type": "domain",
      "layer": "Quality and Operations",
      "description": "Measurement, evaluation, traceability, and reliable execution.",
      "url": "https://developers.openai.com/api/docs/guides/agent-evals"
    },
    {
      "id": "llm",
      "label": "Large Language Model (LLM)",
      "type": "model",
      "layer": "AI and Models",
      "description": "Generates text, code, or tool-call proposals from context. Tools and the runtime determine what it can actually do.",
      "url": "https://developers.openai.com/api/docs/guides/agents"
    },
    {
      "id": "tokens",
      "label": "Tokens",
      "type": "concept",
      "layer": "AI and Models",
      "description": "Units that a model reads and produces. Token use affects cost and how much fits in context."
    },
    {
      "id": "context",
      "label": "Context Window",
      "type": "concept",
      "layer": "AI and Models",
      "description": "The messages, instructions, and retrieved material visible to a model in one run. A larger window is not reliable memory."
    },
    {
      "id": "prompt",
      "label": "Instructions and Prompts",
      "type": "concept",
      "layer": "AI and Models",
      "description": "Tasks, rules, and examples that guide the model. External text must not gain the authority of trusted instructions."
    },
    {
      "id": "function-calling",
      "label": "Tool Calling / Function Calling",
      "type": "mechanism",
      "layer": "AI and Models",
      "description": "The model proposes a named call with arguments; the host validates and executes it, then returns the result.",
      "url": "https://developers.openai.com/api/docs/guides/tools"
    },
    {
      "id": "structured-output",
      "label": "Structured Output",
      "type": "mechanism",
      "layer": "AI and Models",
      "description": "A response in an agreed schema is easier for software to process, but a valid format does not guarantee a correct answer."
    },
    {
      "id": "embeddings",
      "label": "Embeddings",
      "type": "technique",
      "layer": "AI and Models",
      "description": "Vector representations that can support semantic retrieval of relevant material."
    },
    {
      "id": "rag",
      "label": "RAG / Retrieval",
      "type": "technique",
      "layer": "AI and Models",
      "description": "Retrieves relevant material into context before the model answers. Source text can be wrong or malicious."
    },
    {
      "id": "hallucination",
      "label": "False Claim / Hallucination",
      "type": "risk",
      "layer": "AI and Models",
      "description": "A model can produce a convincing but incorrect answer. Source checks and tests must be independent of the model."
    },
    {
      "id": "agent",
      "label": "AI Agent",
      "type": "concept",
      "layer": "Agents and Tools",
      "description": "A model operating in a loop with a goal, context, and available tools. The host determines its authority.",
      "url": "https://developers.openai.com/api/docs/guides/agents"
    },
    {
      "id": "agent-loop",
      "label": "Agent Loop",
      "type": "mechanism",
      "layer": "Agents and Tools",
      "description": "Repeats assessment, tool calls, observation, and next steps until the task finishes or the run stops."
    },
    {
      "id": "harness",
      "label": "Harness / Agent Runtime",
      "type": "component",
      "layer": "Agents and Tools",
      "description": "The program around the model that exposes tools, executes calls, and manages state, limits, and approvals."
    },
    {
      "id": "builtin-tools",
      "label": "Built-in File and Shell Tools",
      "type": "tool",
      "layer": "Agents and Tools",
      "description": "The host product's own read, search, edit, and command functions. Local coding tasks often need no MCP connection."
    },
    {
      "id": "shell-cli",
      "label": "Shell and CLI",
      "type": "tool",
      "layer": "Agents and Tools",
      "description": "Can edit files or call APIs through scripts and command-line tools. Its reach equals the environment's permissions."
    },
    {
      "id": "artifact",
      "label": "Artifact on Disk",
      "type": "concept",
      "layer": "Agents and Tools",
      "description": "Code, configuration, or JSON that takes effect when another process builds, loads, or publishes it."
    },
    {
      "id": "live-system",
      "label": "Live System",
      "type": "concept",
      "layer": "Agents and Tools",
      "description": "A database, SaaS service, sensor, or CI system with current state and actions exposed through an API or protocol."
    },
    {
      "id": "multi-agent",
      "label": "Multiple Specialist Agents",
      "type": "pattern",
      "layer": "Agents and Tools",
      "description": "Work can be delegated between agents, but handoffs, shared state, and permissions must be managed."
    },
    {
      "id": "memory",
      "label": "Memory and State",
      "type": "concept",
      "layer": "Agents and Tools",
      "description": "Conversation history or persistent data reused later. Persistent memory needs protection against errors and poisoning."
    },
    {
      "id": "autonomy",
      "label": "Autonomy Boundary",
      "type": "control",
      "layer": "Agents and Tools",
      "description": "Defines which steps an agent may take alone, how long it may run, and when it must stop or request review."
    },
    {
      "id": "mcp",
      "label": "Model Context Protocol (MCP)",
      "type": "protocol",
      "layer": "MCP and Integration",
      "description": "An open protocol for exchanging context and tools between an AI host and servers. MCP alone is not a security guarantee.",
      "url": "https://modelcontextprotocol.io/docs/2026-07-28/learn/architecture"
    },
    {
      "id": "mcp-host",
      "label": "MCP Host",
      "type": "component",
      "layer": "MCP and Integration",
      "description": "The AI application that coordinates the model and creates client connections to MCP servers.",
      "url": "https://modelcontextprotocol.io/docs/2026-07-28/learn/architecture"
    },
    {
      "id": "mcp-client",
      "label": "MCP Client",
      "type": "component",
      "layer": "MCP and Integration",
      "description": "A host component that establishes and maintains a connection to one MCP server."
    },
    {
      "id": "mcp-server",
      "label": "MCP Server",
      "type": "component",
      "layer": "MCP and Integration",
      "description": "Exposes tools, resources, and/or prompts. Its implementation must validate arguments and enforce access."
    },
    {
      "id": "mcp-tool",
      "label": "MCP Tool",
      "type": "tool",
      "layer": "MCP and Integration",
      "description": "A named function that retrieves data or takes action. The server implementation determines its actual effect.",
      "url": "https://modelcontextprotocol.io/specification/2026-07-28/server/index"
    },
    {
      "id": "mcp-resource",
      "label": "MCP Resource",
      "type": "concept",
      "layer": "MCP and Integration",
      "description": "Content or structured data that the host can make available as context.",
      "url": "https://modelcontextprotocol.io/specification/2026-07-28/server/index"
    },
    {
      "id": "mcp-prompt",
      "label": "MCP Prompt",
      "type": "concept",
      "layer": "MCP and Integration",
      "description": "A reusable prompt template. Server-provided text has its own trust level and should be reviewed accordingly.",
      "url": "https://modelcontextprotocol.io/specification/2026-07-28/server/index"
    },
    {
      "id": "tool-schema",
      "label": "Tool Schema",
      "type": "concept",
      "layer": "MCP and Integration",
      "description": "A name, description, and argument format make capabilities discoverable and calls validatable. A schema alone does not restrict access."
    },
    {
      "id": "task-shaped-tool",
      "label": "Task-shaped Tool",
      "type": "pattern",
      "layer": "MCP and Integration",
      "description": "Offers a narrow action such as 'get alarm history for this area' instead of exposing a general API pass-through."
    },
    {
      "id": "rest-api",
      "label": "REST API",
      "type": "interface",
      "layer": "MCP and Integration",
      "description": "An integration route beneath an MCP tool or directly through code and a CLI. MCP does not require one-to-one REST parity."
    },
    {
      "id": "crm-read",
      "label": "CRM: Read Product Data",
      "type": "example",
      "layer": "MCP and Integration",
      "description": "Can be exposed as a narrow read operation. The SQL or API identity should reach only approved data."
    },
    {
      "id": "tag-read",
      "label": "OT: Read Tag Value",
      "type": "example",
      "layer": "MCP and Integration",
      "description": "Reading a live value requires access to an OT system and a clear boundary between observation and control."
    },
    {
      "id": "alarm-ack",
      "label": "OT: Acknowledge Alarm",
      "type": "example",
      "layer": "MCP and Integration",
      "description": "Changes state in an operations system. Requires specific authorization, traceability, and usually human control."
    },
    {
      "id": "agentic-development",
      "label": "Agentic Development",
      "type": "method",
      "layer": "Agentic Development",
      "description": "Software development in which an agent can plan, edit code, run tests, and propose next steps under human direction."
    },
    {
      "id": "repository",
      "label": "Codebase / Repository",
      "type": "artifact",
      "layer": "Agentic Development",
      "description": "Source code and documentation the agent reads and edits. Repository content can also be untrusted input."
    },
    {
      "id": "plan",
      "label": "Planning and Task Breakdown",
      "type": "stage",
      "layer": "Agentic Development",
      "description": "Clarifies goals, acceptance criteria, constraints, and dependencies before larger changes."
    },
    {
      "id": "implementation",
      "label": "Implementation",
      "type": "stage",
      "layer": "Agentic Development",
      "description": "The agent changes files or calls APIs to complete scoped work."
    },
    {
      "id": "tests",
      "label": "Automated Tests",
      "type": "control",
      "layer": "Agentic Development",
      "description": "Check expected behavior and catch regressions. Useful tests need expectations independent of the implementation."
    },
    {
      "id": "code-review",
      "label": "Code Review",
      "type": "control",
      "layer": "Agentic Development",
      "description": "A person examines changes, assumptions, and side effects before adoption."
    },
    {
      "id": "ci-cd",
      "label": "CI/CD",
      "type": "system",
      "layer": "Agentic Development",
      "description": "Builds, tests, and deployment can turn file changes into a running system. Repository access may therefore have an indirect production effect."
    },
    {
      "id": "skills",
      "label": "Skills / Workflow Instructions",
      "type": "concept",
      "layer": "Agentic Development",
      "description": "Reusable instructions that tell an agent how to use existing tools. A skill alone does not grant new permissions.",
      "url": "https://developers.openai.com/api/docs/guides/agents"
    },
    {
      "id": "git-diff",
      "label": "Diff and Reviewable Change",
      "type": "artifact",
      "layer": "Agentic Development",
      "description": "A visible change in code or data that can be reviewed, tested, and reverted."
    },
    {
      "id": "trust-boundary",
      "label": "Trust Boundary",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Separates trusted user and system instructions from external documents, tool results, and other lower-trust data."
    },
    {
      "id": "prompt-injection",
      "label": "Prompt Injection",
      "type": "risk",
      "layer": "Security and Trust",
      "description": "Instructions hidden in lower-trust content try to redirect the model toward another goal or tool action.",
      "url": "https://genai.owasp.org/2025/12/09/owasp-top-10-for-agentic-applications-the-benchmark-for-agentic-security-in-the-age-of-autonomous-ai/"
    },
    {
      "id": "untrusted-output",
      "label": "Untrusted Tool Result",
      "type": "risk",
      "layer": "Security and Trust",
      "description": "Web pages, documents, and API responses may contain data plus instruction-like text. A result must not gain higher authority."
    },
    {
      "id": "least-privilege",
      "label": "Least Privilege",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Give each identity and tool only the data and actions required, ideally scoped per resource and operation."
    },
    {
      "id": "authorization",
      "label": "Authentication and Authorization",
      "type": "control",
      "layer": "Security and Trust",
      "description": "The executing system must check identity and permission on each relevant call; a model prompt is not access control."
    },
    {
      "id": "secrets",
      "label": "Secret Management",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Keep credentials in a trusted runtime or service, never in prompts, repositories, or logs. Local shell access may still expose environment secrets."
    },
    {
      "id": "sandbox",
      "label": "Sandbox",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Isolates code execution, files, and processes for the task. Network access and mounted secrets must also be limited.",
      "url": "https://developers.openai.com/api/docs/guides/agents-api/environments/security"
    },
    {
      "id": "approval",
      "label": "Human Approval",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Pause before sensitive writes or other side effects. Review is a policy choice, not an automatic MCP property.",
      "url": "https://developers.openai.com/api/docs/guides/agents/guardrails-approvals"
    },
    {
      "id": "audit",
      "label": "Audit Trail",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Record who or what called a tool and with what effect, without leaking sensitive data into logs."
    },
    {
      "id": "egress",
      "label": "Outbound Network Controls",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Limit where an agent environment or integration can send data."
    },
    {
      "id": "exfiltration",
      "label": "Data Exfiltration",
      "type": "risk",
      "layer": "Security and Trust",
      "description": "Sensitive data can leave through responses, tools, logs, or network traffic if access and outbound paths are too broad."
    },
    {
      "id": "supply-chain",
      "label": "Supply Chain and Tool Risk",
      "type": "risk",
      "layer": "Security and Trust",
      "description": "Third-party MCP servers, packages, skills, and tool descriptions may change or contain unwanted behavior."
    },
    {
      "id": "side-effect",
      "label": "Side Effect",
      "type": "concept",
      "layer": "Security and Trust",
      "description": "An action that changes a live system, publication, or an artifact later deployed. Its risk must be explicit."
    },
    {
      "id": "input-validation",
      "label": "Argument Validation",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Tools must check types, permitted values, and target resources before acting. Schema validation does not replace authorization."
    },
    {
      "id": "data-minimization",
      "label": "Data Minimization",
      "type": "control",
      "layer": "Security and Trust",
      "description": "Fetch and send only the fields a task needs to reduce exposure during errors or compromise."
    },
    {
      "id": "jev",
      "label": "Jev (TypeSafe AI)",
      "type": "product",
      "layer": "Jev and Decisions",
      "description": "A model for typed judgments about supplied state. It does not generate prose; it is one possible part of an agent workflow, not MCP itself.",
      "url": "https://docs.typesafe.ai/introduction"
    },
    {
      "id": "typed-decision",
      "label": "Typed Decision",
      "type": "concept",
      "layer": "Jev and Decisions",
      "description": "A result code can use directly, such as a choice, ordinal score, or yes/no probability."
    },
    {
      "id": "choice",
      "label": "Choice",
      "type": "Jev primitive",
      "layer": "Jev and Decisions",
      "description": "Selects among explicit options and returns a probability distribution and confidence.",
      "url": "https://docs.typesafe.ai/primitives"
    },
    {
      "id": "score",
      "label": "Score",
      "type": "Jev primitive",
      "layer": "Jev and Decisions",
      "description": "Judges ordered rubric levels and returns a level, probabilities, and confidence.",
      "url": "https://docs.typesafe.ai/primitives"
    },
    {
      "id": "noul",
      "label": "Noul",
      "type": "Jev primitive",
      "layer": "Jev and Decisions",
      "description": "Returns a 0–1 value for a yes/no question; it has no separate confidence field.",
      "url": "https://docs.typesafe.ai/primitives"
    },
    {
      "id": "confidence",
      "label": "Confidence and Probability",
      "type": "concept",
      "layer": "Jev and Decisions",
      "description": "For Choice and Score, confidence summarizes the distribution; it is not a guarantee that the answer is correct. Noul returns only a probability.",
      "url": "https://docs.typesafe.ai/confidence"
    },
    {
      "id": "decision-policy",
      "label": "Decision Policy",
      "type": "control",
      "layer": "Jev and Decisions",
      "description": "Code defines thresholds, consequences, and permitted actions. A model result alone should not trigger irreversible actions."
    },
    {
      "id": "uncertainty-route",
      "label": "Uncertainty → Review / Fallback",
      "type": "pattern",
      "layer": "Jev and Decisions",
      "description": "For unclear or high-risk results, gather more data, use another method, or involve a person. Test thresholds on your own data."
    },
    {
      "id": "tracing",
      "label": "Tracing",
      "type": "operations",
      "layer": "Quality and Operations",
      "description": "Records model calls, tool calls, handoffs, and outcomes for debugging and audit.",
      "url": "https://developers.openai.com/api/docs/guides/agent-evals"
    },
    {
      "id": "evals",
      "label": "Evaluations (Evals)",
      "type": "method",
      "layer": "Quality and Operations",
      "description": "Measure whether an agent selects appropriate tools, completes tasks, and follows policy on representative cases.",
      "url": "https://developers.openai.com/api/docs/guides/agent-evals"
    },
    {
      "id": "eval-dataset",
      "label": "Evaluation Dataset",
      "type": "artifact",
      "layer": "Quality and Operations",
      "description": "Captures real tasks, edge cases, attacks, and expected outcomes. Maintain it as the system changes."
    },
    {
      "id": "regression",
      "label": "Regression Checks",
      "type": "control",
      "layer": "Quality and Operations",
      "description": "Compare new agent versions against previous quality, cost, and risk before rollout."
    },
    {
      "id": "budget",
      "label": "Time and Cost Budget",
      "type": "control",
      "layer": "Quality and Operations",
      "description": "Limit tool calls, runtime, and cost; stop loops that are not making progress."
    },
    {
      "id": "retry",
      "label": "Retry and Failure Strategy",
      "type": "pattern",
      "layer": "Quality and Operations",
      "description": "Handle temporary errors with bounded retries; distinguish safe reads from side-effecting calls."
    },
    {
      "id": "idempotency",
      "label": "Idempotency",
      "type": "control",
      "layer": "Quality and Operations",
      "description": "Where possible, repeating an operation should not create duplicates or additional effects; important for retries and unreliable networks."
    },
    {
      "id": "human-oversight",
      "label": "Human Ownership",
      "type": "principle",
      "layer": "Quality and Operations",
      "description": "People set goals, grant access, assess consequences, and retain final responsibility."
    }
  ],
